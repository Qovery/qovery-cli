{
 "cases": [
  {
   "name": "env (group)",
   "args": [
    "env"
   ]
  },
  {
   "name": "env unknown sub",
   "args": [
    "env",
    "foo"
   ]
  },
  {
   "name": "env import too many args",
   "args": [
    "env",
    "import",
    "a.env",
    "b.env"
   ]
  },
  {
   "name": "env import too many args --sort",
   "args": [
    "env",
    "import",
    "--sort",
    "a.env",
    "b.env",
    "c"
   ]
  },
  {
   "name": "env import missing file",
   "args": [
    "env",
    "import",
    "nope.env"
   ]
  },
  {
   "name": "env import directory",
   "args": [
    "env",
    "import",
    ".qovery"
   ]
  },
  {
   "name": "env import bad key",
   "args": [
    "env",
    "import",
    "bad.env"
   ],
   "files": {
    "bad.env": "GOOD=1\nfoo-bar=1\n"
   }
  },
  {
   "name": "env import key without value at EOL",
   "args": [
    "env",
    "import",
    "bad.env"
   ],
   "files": {
    "bad.env": "FOO\nBAR=1\n"
   }
  },
  {
   "name": "env import unterminated quote",
   "args": [
    "env",
    "import",
    "bad.env"
   ],
   "files": {
    "bad.env": "A=1\nB=\"abc\nC=2\n"
   }
  },
  {
   "name": "env import unicode key error",
   "args": [
    "env",
    "import",
    "bad.env"
   ],
   "files": {
    "bad.env": "CL\u00c9-X=1\n"
   }
  },
  {
   "name": "env import database service",
   "args": [
    "env",
    "import",
    ".env"
   ],
   "files": {
    ".env": "# comment\nexport FOO=bar\nBAZ=\"multi\\nline\"\nQUX='single $FOO'\nEXP=${FOO}-x # trailing comment\n"
   },
   "context": {
    "service_id": "db-1",
    "service_name": "my-db",
    "service_type": "database"
   }
  },
  {
   "name": "env import job service",
   "args": [
    "env",
    "import",
    ".env"
   ],
   "files": {
    ".env": "# comment\nexport FOO=bar\nBAZ=\"multi\\nline\"\nQUX='single $FOO'\nEXP=${FOO}-x # trailing comment\n"
   },
   "context": {
    "service_id": "cron-1",
    "service_name": "my-cron",
    "service_type": "job"
   }
  },
  {
   "name": "env import no context file",
   "args": [
    "env",
    "import",
    ".env"
   ],
   "files": {
    ".env": "# comment\nexport FOO=bar\nBAZ=\"multi\\nline\"\nQUX='single $FOO'\nEXP=${FOO}-x # trailing comment\n"
   },
   "no_context_file": true
  },
  {
   "name": "env import application (survey prompt)",
   "args": [
    "env",
    "import",
    ".env"
   ],
   "files": {
    ".env": "# comment\nexport FOO=bar\nBAZ=\"multi\\nline\"\nQUX='single $FOO'\nEXP=${FOO}-x # trailing comment\n"
   },
   "ignore": [
    "stdout"
   ]
  },
  {
   "name": "env import container (survey prompt)",
   "args": [
    "env",
    "import",
    "--sort",
    ".env"
   ],
   "files": {
    ".env": "# comment\nexport FOO=bar\nBAZ=\"multi\\nline\"\nQUX='single $FOO'\nEXP=${FOO}-x # trailing comment\n"
   },
   "context": {
    "service_id": "cont-1",
    "service_name": "my-container",
    "service_type": "container"
   },
   "ignore": [
    "stdout"
   ]
  },
  {
   "name": "env import empty file (survey prompt)",
   "args": [
    "env",
    "import",
    "empty.env"
   ],
   "files": {
    "empty.env": ""
   },
   "ignore": [
    "stdout"
   ]
  },
  {
   "name": "env import no args, no .env file",
   "args": [
    "env",
    "import"
   ]
  },
